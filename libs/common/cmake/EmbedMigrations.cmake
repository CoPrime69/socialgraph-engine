# sg_embed_migrations(<target> <dir> <namespace>)
#
# Compiles every SQL migration in <dir> into <target>, so service binaries are self-contained.
# Files must be named NNNN_name.sql (4-digit version, lower-case snake_case name), e.g.
# 0001_create_accounts.sql. The generated translation unit defines
#
#   std::span<const sg::common::Migration> <namespace>::embedded_migrations();
#
# returning the migrations ordered by version. The SQL is read at configure time; adding,
# removing or editing a migration re-runs CMake automatically (CONFIGURE_DEPENDS + the files are
# registered as configure dependencies), and the generated file is only rewritten when its
# content changes.
function(sg_embed_migrations target dir namespace)
  if(NOT TARGET ${target})
    message(FATAL_ERROR "sg_embed_migrations: '${target}' is not a target")
  endif()
  if(NOT namespace MATCHES "^[A-Za-z_][A-Za-z0-9_]*(::[A-Za-z_][A-Za-z0-9_]*)*$")
    message(FATAL_ERROR "sg_embed_migrations: invalid C++ namespace '${namespace}'")
  endif()
  get_filename_component(dir "${dir}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
  file(GLOB sql_files CONFIGURE_DEPENDS "${dir}/*.sql")
  list(SORT sql_files)
  if(NOT sql_files)
    message(FATAL_ERROR "sg_embed_migrations: no *.sql files in ${dir}")
  endif()

  set(entries "")
  set(count 0)
  set(previous_version 0)
  foreach(file IN LISTS sql_files)
    get_filename_component(file_name "${file}" NAME)
    if(NOT file_name MATCHES "^([0-9][0-9][0-9][0-9])_([a-z0-9_]+)\\.sql$")
      message(FATAL_ERROR "sg_embed_migrations: '${file_name}' must be named NNNN_name.sql "
                          "(4 digits, then lower-case letters, digits or _)")
    endif()
    set(version_text "${CMAKE_MATCH_1}")
    set(migration_name "${CMAKE_MATCH_2}")
    # Strip leading zeros so the literal is not parsed as octal.
    string(REGEX REPLACE "^0+" "" version "${version_text}")
    if(version STREQUAL "")
      message(FATAL_ERROR "sg_embed_migrations: version 0000 is reserved (${file_name})")
    endif()
    if(NOT version GREATER previous_version)
      message(FATAL_ERROR "sg_embed_migrations: duplicate migration version ${version_text} (${file_name})")
    endif()
    set(previous_version ${version})
    file(READ "${file}" sql)
    string(FIND "${sql}" ")sg_sql\"" delimiter_position)
    if(NOT delimiter_position EQUAL -1)
      message(FATAL_ERROR "sg_embed_migrations: ${file_name} contains the reserved sequence )sg_sql\"")
    endif()
    string(APPEND entries "      sg::common::Migration{${version}, \"${migration_name}\", R\"sg_sql(${sql})sg_sql\"},\n")
    math(EXPR count "${count} + 1")
  endforeach()

  set_property(DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${sql_files})

  string(MAKE_C_IDENTIFIER "${target}" target_id)
  set(output "${CMAKE_CURRENT_BINARY_DIR}/${target_id}_embedded_migrations.cpp")
  set(content "// Generated by sg_embed_migrations() from ${dir}. Do not edit.\n")
  string(APPEND content "#include <array>\n#include <span>\n\n#include <sg/common/migration.hpp>\n\n")
  string(APPEND content "namespace ${namespace} {\n\n")
  string(APPEND content "std::span<const sg::common::Migration> embedded_migrations();\n\n")
  string(APPEND content "std::span<const sg::common::Migration> embedded_migrations() {\n")
  string(APPEND content "  static const std::array<sg::common::Migration, ${count}> migrations{\n")
  string(APPEND content "${entries}")
  string(APPEND content "  };\n  return migrations;\n}\n\n}  // namespace ${namespace}\n")

  set(staging "${output}.staging")
  file(WRITE "${staging}" "${content}")
  configure_file("${staging}" "${output}" COPYONLY)
  target_sources(${target} PRIVATE "${output}")
endfunction()

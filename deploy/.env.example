# Copy to deploy/.env (or run scripts/generate-env.sh, which fills every secret with random values).
# Never commit deploy/.env.
POSTGRES_PASSWORD=change-me
IDENTITY_DB_PASSWORD=change-me
GRAPH_DB_PASSWORD=change-me
CONTENT_DB_PASSWORD=change-me
# Ed25519 key pair, base64 (32-byte seed / 32-byte public key). Generate with scripts/generate-env.sh.
AUTH_SIGNING_SEED=
AUTH_PUBLIC_KEY=
AUTH_TOKEN_TTL_SECONDS=28800
# Loads the Stack Overflow 2008 dataset (data/stackoverflow) into empty databases. The demo account
# (handle "demo") gets this password; imported Stack Overflow members cannot log in.
SEED_ON_EMPTY=true
SEED_DEMO_PASSWORD=change-me
GATEWAY_PORT=8080
LOG_LEVEL=info

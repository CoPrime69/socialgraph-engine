# Copy to .env.local to override the upstreams used by the Vite dev/preview proxy.
# They are read only by vite.config.ts; the browser always calls relative /api/v1/... URLs.
VITE_IDENTITY_URL=http://localhost:8081
VITE_GRAPH_URL=http://localhost:8082
VITE_ANALYTICS_URL=http://localhost:8083
VITE_CONTENT_URL=http://localhost:8084

# Optional dev-server port (default 5173)
# VITE_DEV_PORT=5173
